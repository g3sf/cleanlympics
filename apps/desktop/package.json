{
  "name": "@cleanlympics/desktop",
  "version": "0.3.4",
  "description": "Cleanlympics staff checklist and administration desktop app",
  "author": "Cleanlympics",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {"dev":"concurrently -k \"vite --configLoader runner\" \"wait-on tcp:5173 && electron .\"","build":"vite build --configLoader runner","dist:win":"npm run build && electron-builder --win nsis","dist:appx":"npm run build && electron-builder --win appx","dist:msix":"npm run dist:appx && node ../../scripts/rename-appx-to-msix.mjs"},
  "dependencies": {"@vitejs/plugin-react":"^5.0.2","bcryptjs":"^3.0.2","better-sqlite3":"^13.0.3","jsonwebtoken":"^9.0.2","vite":"^7.1.3","react":"^19.1.1","react-dom":"^19.1.1"},
  "devDependencies": {"concurrently":"^9.2.1","electron":"44.0.0","electron-builder":"^26.15.3","wait-on":"^8.0.4"},
  "build": {
    "appId":"org.cleanlympics.desktop",
    "productName":"Cleanlympics",
    "directories":{"output":"release"},
    "files":["dist/**/*","electron/**/*","build/icon.ico","package.json"],
    "asar":true,
    "asarUnpack":["node_modules/better-sqlite3/prebuilds/win32-x64.node"],
    "npmRebuild":true,
    "win":{"target":"nsis","icon":"build/icon.ico"},
    "appx":{"identityName":"Cleanlympics.Desktop","applicationId":"Cleanlympics.Desktop","publisher":"CN=Cleanlympics Local","publisherDisplayName":"Cleanlympics","displayName":"Cleanlympics"},
    "nsis":{"oneClick":false,"allowToChangeInstallationDirectory":true,"createDesktopShortcut":true,"createStartMenuShortcut":true,"shortcutName":"Cleanlympics","installerIcon":"build/icon.ico","uninstallerIcon":"build/icon.ico"}
  }
}
