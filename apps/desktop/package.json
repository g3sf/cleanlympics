{
  "name": "@cleanlympics/desktop",
  "version": "0.2.5-staff-beta",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {"dev":"concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"","build":"vite build","dist:win":"npm run build && electron-builder --win nsis"},
  "dependencies": {"@vitejs/plugin-react":"^5.0.2","axios":"^1.11.0","electron-store":"^10.1.0","vite":"^7.1.3","react":"^19.1.1","react-dom":"^19.1.1"},
  "devDependencies": {"concurrently":"^9.2.1","electron":"^37.3.1","electron-builder":"^26.0.12","wait-on":"^8.0.4"},
  "build": {
    "appId":"org.cleanlympics.desktop",
    "productName":"Cleanlympics",
    "directories":{"output":"release"},
    "files":["dist/**/*","electron/**/*","package.json"],
    "win":{"target":"nsis","icon":"build/icon.ico"},
    "nsis":{"oneClick":false,"allowToChangeInstallationDirectory":true,"createDesktopShortcut":true,"createStartMenuShortcut":true,"shortcutName":"Cleanlympics","installerIcon":"build/icon.ico","uninstallerIcon":"build/icon.ico"}
  }
}
